%subsection - 10pt, bold
%subsubsection - 10pt, bold


\renewcommand\section{\@startsection {section}{1}{\z@}{-6.80077mm}{3.95393mm}{\reset@font\large\bf}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}{-6.40536mm}{2.68866mm}{\reset@font\bf}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}{-6.40536mm}{2.68866mm}{\reset@font\bf}}

\renewcommand\thesection{\@arabic\c@section}
\renewcommand\thesubsection{\@arabic\c@section.\@arabic\c@subsection}

